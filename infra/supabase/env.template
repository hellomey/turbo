# Vercel environment variables for the API project (apps/api). Values live in Vercel, never in git.
HEYMEY_ENV=staging
NODE_ENV=production
# Supabase transaction pooler (port 6543), for the running API.
DATABASE_URL=postgresql://postgres.femlzgwiilwccyudleai:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase session pooler (port 5432), for migrations and seeding only.
DIRECT_URL=postgresql://postgres.femlzgwiilwccyudleai:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres
# Auth keys: generate with `pnpm env:dev` style script or openssl; Ed25519 PEM pair, 32-byte secrets.
JWT_ISSUER=https://api.heymey.app
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
OTP_PEPPER=
TOTP_ENC_KEY=
CHANGEDETECTION_WEBHOOK_SECRET=
CORS_ORIGINS=https://app.heymey.app,https://desk.heymey.app
MIN_APP_VERSION=1.0.0
TRUST_PROXY_HOPS=1
# Email OTP: Gmail SMTP first (about 500 a day), Brevo automatically if Gmail fails (300 a day).
# Gmail needs an App Password: Google account > Security > 2-Step Verification > App passwords. Not your normal password.
EMAIL_PROVIDER=smtp
EMAIL_FALLBACK_PROVIDER=brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=HeyMey
