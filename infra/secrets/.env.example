# Key names only. Real values live in production.enc.env / staging.enc.env (SOPS).
POSTGRES_PASSWORD=change-me
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
OTP_PEPPER=at-least-32-random-characters-xxxxxxxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HeyMey <no-reply@mail.heymey.app>"
OPENROUTER_API_KEY=
AI_MONTHLY_BUDGET_INR=30000
S3_ACCESS_KEY=
S3_SECRET_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
GLITCHTIP_DSN=
OPS_ALLOWLIST=10.8.0.0/24
CLOUDFLARE_API_TOKEN=
TELEGRAM_ALERT_BOT_TOKEN=
# Valkey auth (SEC-M2): required by compose.yml in staging/production; URL-safe, e.g. `openssl rand -hex 32`.
VALKEY_PASSWORD=change-me-hex-64
# Edge (Caddy) only, in production.env: lets the deploy pipeline's smoke + k6 reach staging-api/staging-rt,
# which are otherwise ops-allowlist-only. >= 32 chars of [A-Za-z0-9_-] (`openssl rand -hex 32`); unset = closed.
STAGING_ACCESS_KEY=
