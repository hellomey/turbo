# Third-party images in ONE place, pinned by version tag + multi-arch index digest (decision D-2026-10-20-07,
# blueprint §21/§42). Every digest below is the OCI image index / manifest list and includes linux/amd64 and linux/arm64 (Oracle Ampere VM, BOLT-0023).
# Pinned in BOLT-0005 (2026-10-20) with `docker buildx imagetools inspect <image>:<tag>`.
#
# Used by compose.dev.yml, compose.yml, compose.monitoring.yml and compose.edge.yml via --env-file images.env.
# Dockerfiles cannot read this file: infra/docker/*.Dockerfile repeat the same pins in their FROM lines
# (NODE_IMAGE, CADDY_IMAGE, POSTGRES_IMAGE in backup.Dockerfile) - change both places together.
#
# Upgrade: pick a new stable tag (never `latest`), `docker buildx imagetools inspect <image>:<tag>`, copy the
# top-level Digest, open a PR, let staging soak (docs/runbooks/release.md).

# Data (POSTGRES/SEAWEEDFS/MAILPIT: local dev only since BOLT-0023; production uses Supabase + R2)
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
VALKEY_IMAGE=valkey/valkey:8.1.10-alpine@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d
MAILPIT_IMAGE=axllent/mailpit:v1.31.6@sha256:23fe39e81bde596a918000b3135c0f85dc8bb4c9ea6be274b051143f3e300387

# Edge
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f

# Build base (referenced by infra/docker/*.Dockerfile FROM lines; kept here for the record)
NODE_IMAGE=node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5

