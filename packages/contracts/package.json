{
  "name": "@heymey/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THE contract. Zod schemas for every HTTP route and socket event. OpenAPI 3.1 is generated from here; the Dart client is generated from that.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./openapi.json": "./openapi/openapi.json"
  },
  "scripts": {
    "codegen": "tsx scripts/generate-openapi.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@heymey/eslint-config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
