  },
  "devDependencies": {
    "@heymey/eslint-config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
