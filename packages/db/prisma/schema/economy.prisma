// Tables owned by the `economy` module. No other module may query these (blueprint §34.8).
//
// FIREWALL (§5.3): SparksLedger and PointsLedger are two separate, append-only tables with NO relation
// between them and no conversion path. Balances are SUM(delta) (cached in Valkey, never stored here).

enum SparksSource {
  purchase
  milestone
  spend
  reversal
}

model SparksLedger {
  id             BigInt       @id @default(autoincrement())
  userId         String       @db.Uuid
  delta          Int // integer Sparks; reversal may drive balance negative (§17.4)
  source         SparksSource
  reference      String // store transaction id / milestone id / store item id
  idempotencyKey String       @unique // = store transaction id for purchases (§41)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
}

model PointsLedger {
  id             BigInt   @id @default(autoincrement())
  userId         String   @db.Uuid
  delta          Int
  reason         String // "check_in" | "practice" | "game:<gameId>" | "help_answer" | "spend:<itemId>"
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model TrophyLedger {
  id             BigInt   @id @default(autoincrement())
  userId         String   @db.Uuid
  seasonId       String   @db.Uuid
  delta          Int
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, seasonId])
}

