// Tables owned by the `economy` module. No other module may query these (blueprint §34.8).
//
// FIREWALL (§5.3): SparksLedger and PointsLedger are two separate, append-only tables with NO relation
// between them and no conversion path. Balances are SUM(delta) (cached in Valkey, never stored here).

enum SparksSource {
  purchase
  milestone
  spend
  reversal
}

model SparksLedger {
  id             BigInt       @id @default(autoincrement())
  userId         String       @db.Uuid
  delta          Int // integer Sparks; reversal may drive balance negative (§17.4)
  source         SparksSource
  reference      String // store transaction id / milestone id / store item id
  idempotencyKey String       @unique // = store transaction id for purchases (§41)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
}

model PointsLedger {
  id             BigInt   @id @default(autoincrement())
  userId         String   @db.Uuid
  delta          Int
  reason         String // "check_in" | "practice" | "game:<gameId>" | "help_answer" | "spend:<itemId>"
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model TrophyLedger {
  id             BigInt   @id @default(autoincrement())
  userId         String   @db.Uuid
  seasonId       String   @db.Uuid
  delta          Int
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, seasonId])
}

// To model in week 3: Cosmetic (soldForMoney flag drives firewall FW-005), UserCosmetic,
// CheckInTrack (never resets), Season, SeasonPassProgress, SpendingLimit.

// BOLT-0113. XP is not a currency: these rows are an award log so each learning event is credited once. XP has no
// conversion path to Points, Sparks or anything bought (FW-021, FW-025). Balance = SUM(amount).
model XpAward {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.Uuid
  amount    Int
  reason    String // lesson_done | lit | recall_pass | relight | gold | mock_submitted | check_in
  sourceKey String // stable per source event, e.g. "lit:<topicId>", "mock_submitted:<attemptId>", "check_in:<istDay>"
  createdAt DateTime

  @@unique([userId, sourceKey])
  @@index([createdAt])
}

/// Badges (first lamp, first Gold, ...). Not the seasonal TROPHIES currency in TrophyLedger. One row per code.
model UserTrophy {
  userId   String   @db.Uuid
  code     String
  earnedAt DateTime

  @@id([userId, code])
}

/// Weekly leaderboard opt-in. No row = not opted in (default off).
model LeaderboardOptIn {
  userId    String   @id @db.Uuid
  optIn     Boolean
  updatedAt DateTime
}
