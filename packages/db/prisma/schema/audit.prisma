// Tables owned by the `audit` module. APPEND-ONLY: never updated or deleted by application code.

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  actorId   String?  @db.Uuid // null = system
  actorRole String
  action    String // "odds.publish" | "refund.override" | "role.grant" | ...
  target    String? // "user:<id>" | "product:<id>" ...
  before    Json?
  after     Json?
  ip        String?
  requestId String?

  @@index([actorId, at])
  @@index([action, at])
}
