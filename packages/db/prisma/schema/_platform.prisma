// Cross-cutting platform tables owned by the API platform layer (not a business module).

/// Idempotency-Key store (§34.3, §37). Key + response kept 24 hours. Valkey is the fast path; this is the durable copy
/// for money endpoints where a lost cache entry must not cause a double credit.
model IdempotencyRecord {
  scope       String // e.g. "POST /v1/billing/google/verify:<userId>"
  key         String   @db.Uuid
  requestHash String
  status      Int
  body        Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([scope, key])
  @@index([expiresAt])
}

/// Sync outbox acceptance log (§39): each client action UUID is accepted exactly once.
model SyncReceipt {
  clientActionId String   @id @db.Uuid
  userId         String   @db.Uuid
  kind           String
  acceptedAt     DateTime @default(now())
  clientAt       DateTime

  @@index([userId, acceptedAt])
}

/// Fixed-window rate limit counters (replaces Valkey INCR/EXPIRE, ADR for the Vercel + Supabase deploy). Rows are
/// deleted by the cleanup job once `resetAt` has passed.
model RateLimitCounter {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// One-time token marks (replaces Valkey SET NX): a JWT id may be used once, e.g. the Desk TOTP challenge.
model OneTimeToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// Background job queue in Postgres (replaces BullMQ). Claimed with FOR UPDATE SKIP LOCKED by /internal/jobs/*.
/// `data` of email jobs holds an address and a one-time code: rows are deleted as soon as the job is sent (SEC-M2).
model JobQueueItem {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  name        String
  jobId       String?   @unique
  data        Json
  status      String    @default("pending") // pending | running | failed
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([queue, status, runAt])
}
