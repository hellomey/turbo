{
  "name": "@heymey/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ports, environment schemas and runtime config shared by every TypeScript service.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./ports.json": "./ports.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@heymey/eslint-config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
