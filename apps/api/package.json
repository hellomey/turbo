{
  "name": "@heymey/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS HTTP API on Fastify. https://api.heymey.app/v1 - local port 4567.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@heymey/config": "workspace:*",
    "@heymey/contracts": "workspace:*",
    "@heymey/db": "workspace:*",
    "@heymey/domain": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "bullmq": "^6.3.18",
    "fastify": "^5.0.0",
    "ioredis": "^6.0.0",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@heymey/eslint-config": "workspace:*",
    "@heymey/testing": "workspace:*",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
