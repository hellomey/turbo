{
  "name": "@heymey/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Socket.IO gateway + server-authoritative game rooms. wss://rt.heymey.app - local port 4568.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@heymey/config": "workspace:*",
    "@heymey/contracts": "workspace:*",
    "@heymey/domain": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@heymey/eslint-config": "workspace:*",
    "@nestjs/cli": "^12.0.9",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
